{
  "name": "earwyrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "build": "npm run build --workspaces && tsc -p tsconfig.json",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace @earwyrm/api",
    "test:web": "npm run test --workspace @earwyrm/web -- --run",
    "dev": "npm run dev:api",
    "dev:api": "tsx apps/api/src/web_app.ts",
    "dev:web": "npm run dev --workspace @earwyrm/web",
    "start": "node apps/api/dist/web_app.js",
    "platform": "tsx apps/api/src/platform_service.ts",
    "lyric-mcp": "tsx apps/api/src/lyric_mcp.ts",
    "melody-mcp": "tsx apps/api/src/melody_mcp.ts",
    "render": "tsx apps/api/src/cli.ts",
    "database": "tsx apps/api/src/bootstrap_database.ts",
    "deployment-gate": "tsx scripts/deployment_gate.ts",
    "bootstrap-deployment": "tsx scripts/bootstrap_deployment.ts",
    "contracts": "tsx apps/api/src/contracts.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
