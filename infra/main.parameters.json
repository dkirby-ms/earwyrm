{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "sellerApiClientId": { "value": "${SELLER_API_CLIENT_ID}" },
    "backendApiClientId": { "value": "${BACKEND_API_CLIENT_ID}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "publisherEmail": { "value": "${APIM_PUBLISHER_EMAIL}" },
    "modelLocation": { "value": "${MODEL_LOCATION=eastus2}" },
    "modelName": { "value": "${MODEL_NAME=gpt-4.1-mini}" },
    "modelVersion": { "value": "${MODEL_VERSION=2025-04-14}" },
    "modelSku": { "value": "${MODEL_SKU=GlobalStandard}" },
    "modelCapacity": { "value": "${MODEL_CAPACITY=10}" },
    "safetyLocation": { "value": "${SAFETY_LOCATION=eastus2}" },
    "speechLocation": { "value": "${SPEECH_LOCATION=eastus2}" },
    "apimSku": { "value": "${APIM_SKU=Developer}" }
  }
}
