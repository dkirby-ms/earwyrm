{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "keyVaultName": { "value": "${AZURE_KEY_VAULT_NAME}" },
    "keyVaultResourceGroupName": { "value": "${AZURE_KEY_VAULT_RESOURCE_GROUP}" },
    "databasePasswordSecretName": { "value": "${AZURE_POSTGRESQL_PASSWORD_SECRET_NAME}" },
    "databaseAdminLogin": { "value": "${AZURE_POSTGRESQL_ADMIN_LOGIN}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID}" },
    "entraAuthority": { "value": "${ENTRA_AUTHORITY}" },
    "entraMetadataUrl": { "value": "${ENTRA_METADATA_URL}" },
    "entraExpectedIssuer": { "value": "${ENTRA_EXPECTED_ISSUER}" },
    "entraAudience": { "value": "${ENTRA_AUDIENCE}" },
    "entraApiScopePrefix": { "value": "${ENTRA_API_SCOPE_PREFIX}" },
    "speechSettingsEncoded": { "value": "${EARWYRM_SPEECH_SETTINGS_ENCODED}" },
    "lyricSettingsEncoded": { "value": "${EARWYRM_LYRIC_SETTINGS_ENCODED}" }
  }
}
