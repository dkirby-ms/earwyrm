    "@opentelemetry/api": "^1.9.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
