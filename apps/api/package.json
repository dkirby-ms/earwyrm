{
  "name": "@earwyrm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "dev": "tsx src/web_app.ts",
    "start": "node dist/web_app.js",
    "platform": "tsx src/platform_service.ts",
