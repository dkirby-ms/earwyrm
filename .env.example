# These are fictional examples. Replace all six with the existing tenant values.
# The example.invalid domain cannot authenticate users.
ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
ENTRA_AUTHORITY=https://tenant.example.invalid/example-tenant
ENTRA_METADATA_URL=https://tenant.example.invalid/example-tenant/v2.0/.well-known/openid-configuration
ENTRA_EXPECTED_ISSUER=https://tenant.example.invalid/example-tenant/v2.0
ENTRA_AUDIENCE=22222222-2222-2222-2222-222222222222
ENTRA_API_SCOPE_PREFIX=api://22222222-2222-2222-2222-222222222222

# Optional: set an absolute path for private local audio and evaluation data.
# EARWYRM_DATA_DIR=/absolute/path/to/private-data

# Paid Speech requires separate authorization and additional configuration.
SPEECH_ENABLED=false
# SPEECH_ALLOWED_SUBJECT=example-user-subject
# SPEECH_KEY=replace-with-your-speech-key
# SPEECH_REGION=eastus
# SPEECH_PER_RUN_CAP_USD=0.25
